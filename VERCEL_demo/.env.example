# ─────────────────────────────────────────────────────────────
#  Copy this file to .env, then fill in the REQUIRED block.
#      cp .env.example .env
#      npm run check
# ─────────────────────────────────────────────────────────────

# Quick start (no persistent memory):
#   OPENAI_API_KEY=sk-proj_replace-with-your-key
#   MEMORY_MODE=off
#
# Memory example (choose provider, middleware, tools, or hooks):
#   OPENAI_API_KEY=sk-proj_replace-with-your-key
#   MEMORY_MODE=provider
#   MEMORY_API_KEY=nams_replace-with-your-key
#   WORKSPACE_ID=your-name-or-student-id
#
# Never commit .env or paste real keys into this file.


# ── REQUIRED ─────────────────────────────────────────────────

# Lets the agent think.
#   Get one: create or sign in to an OpenAI Platform account, then open
#   https://platform.openai.com/api-keys and select "Create new secret key".
#   Example: sk-proj-AbC123...
OPENAI_API_KEY=

# Which memory integration is live. This is the workshop's switch.
#   off         no memory — start here, watch it forget you
#   provider    createNamsProvider() — memory the model can't see
#   middleware  createNams().wrap()  — same, wrapping one model
#   tools       createNamsMemoryTools() — the model calls query_memory / store_memory
#   hooks       eve hooks + dynamic instructions — the runtime remembers, not the model
# Every non-off mode uses the @neo4j-labs/nams-ai-provider package.
MEMORY_MODE=off

# Lets the agent remember. Only used when MEMORY_MODE is not "off".
#   Get one: create or sign in to a free Neo4j Agent Memory account at
#   https://memory.neo4jlabs.com, then create an API key in its dashboard.
#   Example: nams_1a2b3c4d5e6f...
MEMORY_API_KEY=

# Whose memory this is. Only used when MEMORY_MODE is not "off".
# Put your OWN name here so you don't share a brain with the
# person sitting next to you.
#   Example: ananya
WORKSPACE_ID=


# ── OPTIONAL ─────────────────────────────────────────────────
# Everything below has a working default. Leave blank to use it.

# Use Vercel AI Gateway instead of OpenAI directly. One key reaches
# OpenAI, Anthropic, Google and others.
#   Get one: sign in to Vercel, select a team, then open
#   https://vercel.com/dashboard → AI Gateway → API Keys.
#   Example: vck_AbC123...
AI_GATEWAY_API_KEY=

# Force which route the model takes. Blank = auto: OpenAI wins when
# OPENAI_API_KEY is set and no gateway credential is present.
#   Values:  openai | gateway | openai-compatible
MODEL_ROUTING=

# ── Open-source / OpenAI-compatible providers ──────────────
# Use any provider that speaks the OpenAI API (Groq, Ollama, Moonshot/Kimi,
# Together, Fireworks, LiteLLM, …) without going through Vercel Gateway.
# Set MODEL_ROUTING=openai-compatible (or just set the URL — it auto-detects).
#   Example (Kimi):    OPENAI_COMPATIBLE_BASE_URL=https://api.moonshot.cn/v1
#                      OPENAI_COMPATIBLE_API_KEY=sk-...   AGENT_MODEL=kimi-k2
#   Example (Groq):    OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
#                      OPENAI_COMPATIBLE_API_KEY=gsk_...  AGENT_MODEL=llama-3.3-70b-versatile
#   Example (Ollama):  OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
#                      (no key needed)                    AGENT_MODEL=llama3.2
#   Example (LiteLLM): OPENAI_COMPATIBLE_BASE_URL=http://localhost:4000
#                      OPENAI_COMPATIBLE_API_KEY=<litellm-master-key>
#                      AGENT_MODEL=<any model name configured in LiteLLM>
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Which model answers.
#   Default: openai/gpt-5.4-mini
#   Example: anthropic/claude-sonnet-5   (needs the gateway route)
#   Example: moonshotai/kimi-k2          (open-source, needs the gateway route)
AGENT_MODEL=

# That model's context window, in tokens. eve uses it to decide when
# to compact a long conversation. Lower it for a smaller model.
#   Default: 400000
AGENT_MODEL_CONTEXT_TOKENS=

# The NAMS memory server. Required whenever MEMORY_MODE is not "off" — no
# endpoint is defaulted in code. The value below is the hosted one; replace it
# only when your NAMS administrator gives you a self-hosted API URL.
#   Example: https://nams.example.com/v1
MEMORY_ENDPOINT=https://memory.neo4jlabs.com/v1

# ── MEMORY_MODE=hooks only ──

# How many recalled memories the dynamic instruction pastes into the prompt.
#   Default: 6
MEMORY_MAX_HITS=

# The reasoning trail: one NAMS record per model step, with its tool calls.
# Costs one extra request per turn. Set to "off" to skip it.
#   Default: on
MEMORY_REASONING=

# ── Neo4j knowledge-graph MCP (the read-only graph tools) ──
# One connection, three possible servers.
#
# No URL is written into the code any more: if MCP_URL is blank the graph MCP
# tools are simply off. Pick ONE of the three lines below and uncomment it.
#
# Leave MCP_URL blank for a LOCAL server (no auth) — run one with:
#   pipx install neo4j-mcp-server
#   NEO4J_TRANSPORT_MODE=http NEO4J_MCP_HTTP_PORT=8000 \
#   NEO4J_MCP_URI=bolt://localhost:7687 NEO4J_MCP_USERNAME=neo4j \
#   NEO4J_MCP_PASSWORD=your-password neo4j-mcp
#
# Or point it at one of these instead:
#   Hosted demo (Basic auth, public read-only "companies" graph)
#     MCP_URL=https://neo4j-mcp-official-1008050579172.us-central1.run.app/mcp
#   Aura MCP instance (Bearer token — see MCP_BEARER_TOKEN below)
#     MCP_URL=https://a7b03b2d.mcp-instances.neo4j.io
#
# The connection is skipped entirely when nothing answers at MCP_URL, so a
# wrong or unreachable value costs you the graph tools, not the session.
# MCP_URL=http://localhost:8000/mcp
# MCP_URL=https://neo4j-mcp-official-1008050579172.us-central1.run.app/mcp
# MCP_URL=https://-.mcp-instances.neo4j.io
MCP_URL=

# How to authenticate: none | basic | bearer.
# Blank means auto — bearer if MCP_BEARER_TOKEN is set, else basic if a
# username or password is set below, else none. Set it only to override.
MCP_AUTH=

# Basic auth, for the hosted demo or your own password-protected server.
# Nothing is defaulted in code — for the hosted demo, set both to: companies
MCP_NEO4J_USERNAME=
MCP_NEO4J_PASSWORD=

# Bearer token, for an Aura MCP instance. No default — this is a real
# credential. Aura issues it via OAuth (Auth0); docs/mcp-connections.md
# explains how to obtain one and how to keep it fresh.
MCP_BEARER_TOKEN=

# ── Local investments MCP server (mcp-server/) ──
# A second, local MCP server built in this repo. It exposes one tool,
# get_investments, over Streamable HTTP. Start it with:
#   npm run mcp
# The agent mounts agent/connections/neo4j-investments.ts only when something
# answers there, so leaving it off just means the tool is absent.
# Blank means the tool is off; this is the value to use with `npm run mcp`.
INVESTMENTS_MCP_URL=http://localhost:8100/mcp
# Port and path the server itself binds (defaults 8100 and /mcp).
INVESTMENTS_MCP_PORT=
INVESTMENTS_MCP_PATH=
# Set to "stdio" to run it for Claude Desktop instead of over HTTP.
MCP_TRANSPORT=

# ── Framework web_search (agent/tools/web_search.ts) ──
# eve ships a built-in, provider-executed web_search tool. It is disabled here
# so company questions go to the graph (search_news + the MCP tools) instead of
# the open web. Set to "on" to hand it back to the model.
WEB_SEARCH=

# ── Neo4j Bolt (the search_news tool) ──
# The search_news tool runs a full-text query the MCP server has no tool for,
# so it connects over the Bolt driver. The mcp-server/ investments tool reads
# these same four. Nothing is defaulted in code — these values are the public
# read-only "Company News" demo graph, so they work as shipped.
#   Example (local): NEO4J_URI=bolt://localhost:7687
NEO4J_URI=neo4j+s://demo.neo4jlabs.com:7687
NEO4J_USERNAME=companies
NEO4J_PASSWORD=companies
NEO4J_DATABASE=companies
